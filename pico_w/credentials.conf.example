# Copy this file to credentials.conf and fill in your values.
# credentials.conf is gitignored — never commit secrets.
#
# Build with:
#   west build -b rpi_pico/rp2040/w -- \
#       -DOVERLAY_CONFIG="prj.conf;credentials.conf"

CONFIG_GARAGE_WIFI_SSID="your_ssid_here"
CONFIG_GARAGE_WIFI_PSK="your_wifi_password"

CONFIG_GARAGE_MQTT_BROKER="192.168.1.100"   # Home Assistant / Mosquitto IP
CONFIG_GARAGE_MQTT_PORT=1883
CONFIG_GARAGE_MQTT_USER="mqtt_user"
CONFIG_GARAGE_MQTT_PASSWORD="mqtt_password"
